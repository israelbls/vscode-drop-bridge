{
  "name": "vscode-drop-bridge-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Development workspace for VSCode Drop Bridge",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "build:vscode": "cd vscode-extension && npm run compile",
    "package:vscode": "cd vscode-extension && npm run package",
    "package:browser": "cd browser-extension && zip -r ../vscode-drop-bridge-browser.zip ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "archiver": "^7.0.1",
    "sharp": "^0.35.4"
  }
}
