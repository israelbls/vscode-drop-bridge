{
  "name": "vscode-drop-bridge-workspace",
  "version": "1.1.1",
  "private": true,
  "description": "Development workspace for VSCode Drop Bridge",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "build:vscode": "cd vscode-extension && npm run compile",
    "package:vscode": "cd vscode-extension && npm run package",
    "package:browser": "mkdir -p dist && cd ${BROWSER}-extension && zip -r ../dist/vscode-drop-bridge-${BROWSER}-${npm_package_version}.zip .",
    "package:browser:chrome": "BROWSER=chrome npm run package:browser",
    "package:browser:firefox": "BROWSER=firefox npm run package:browser",
    "package:browser:all": "npm run package:browser:chrome && npm run package:browser:firefox",
    "package:all": "npm run package:vscode && npm run package:browser:all",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky",
    "version": "node scripts/sync-browser-version.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "archiver": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "sharp": "^0.35.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": "biome check --write"
  }
}
