{
  "manifest_version": 3,
  "name": "VSCode Drag Helper",
  "version": "1.0",
  "description": "Allow dragging files from VSCode into web pages by reading local files via a native helper.",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "VSCode Drag Helper"
  }
}
